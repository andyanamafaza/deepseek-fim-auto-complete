{
  "name": "deepseek-fim-auto-complete",
  "displayName": "DeepSeek Autocomplete",
  "description": "AI-powered code completions using DeepSeek Fill-in-the-Middle API. Context-aware inline suggestions with cross-file context, git diff awareness, TF-IDF similar code matching, diagnostics, adaptive streaming, true LRU cache, gzip, and multi-line support for 16+ languages.",
  "version": "0.2.0",
  "publisher": "andyanamafaza",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyanamafaza/deepseek-fim-auto-complete.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "fim",
    "autocomplete",
    "fill in the middle",
    "code completion",
    "ai",
    "copilot",
    "inline completion",
    "code suggestions",
    "deepseek coder",
    "ghost text",
    "multi-line",
    "streaming",
    "vscode extension"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:swift",
    "onLanguage:kotlin",
    "onLanguage:scala",
    "onLanguage:lua",
    "onLanguage:sql",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:dart",
    "onLanguage:elixir",
    "onLanguage:r",
    "onLanguage:perl",
    "onLanguage:powershell",
    "onLanguage:objective-c",
    "onLanguage:objective-cpp",
    "onLanguage:markdown",
    "onLanguage:json",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseekFim.enable",
        "title": "DeepSeek Autocomplete: Enable"
      },
      {
        "command": "deepseekFim.disable",
        "title": "DeepSeek Autocomplete: Disable"
      },
      {
        "command": "deepseekFim.toggle",
        "title": "DeepSeek Autocomplete: Toggle"
      },
      {
        "command": "deepseekFim.setApiKey",
        "title": "DeepSeek Autocomplete: Set API Key"
      },
      {
        "command": "deepseekFim.showStats",
        "title": "DeepSeek Autocomplete: Usage Statistics"
      },
      {
        "command": "deepseekFim.showLog",
        "title": "DeepSeek Autocomplete: Debug Log"
      },
      {
        "command": "deepseekFim.selectModel",
        "title": "DeepSeek Autocomplete: Select Model"
      },
      {
        "command": "deepseekFim.setTemperature",
        "title": "DeepSeek Autocomplete: Set Temperature"
      },
      {
        "command": "deepseekFim.setMaxTokens",
        "title": "DeepSeek Autocomplete: Set Max Tokens"
      },
      {
        "command": "deepseekFim.deleteApiKey",
        "title": "DeepSeek Autocomplete: Delete API Key"
      },
      {
        "command": "deepseekFim.benchmarkModels",
        "title": "DeepSeek Autocomplete: Benchmark Models"
      },
      {
        "command": "deepseekFim.acceptNextWord",
        "title": "DeepSeek Autocomplete: Accept Next Word"
      },
      {
        "command": "deepseekFim.nextSuggestion",
        "title": "DeepSeek Autocomplete: Next Suggestion"
      },
      {
        "command": "deepseekFim.previousSuggestion",
        "title": "DeepSeek Autocomplete: Previous Suggestion"
      },
      {
        "command": "deepseekFim.testConnection",
        "title": "DeepSeek Autocomplete: Test Connection"
      },
      {
        "command": "deepseekFim.statusBarMenu",
        "title": "DeepSeek Autocomplete: Status Bar Menu"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "deepseekFim.statusBarMenu",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deepseekFim.toggle",
        "key": "ctrl+shift+.",
        "when": "editorTextFocus"
      },
      {
        "command": "deepseekFim.nextSuggestion",
        "key": "alt+]",
        "when": "editorTextFocus && inlineSuggestionVisible"
      },
      {
        "command": "deepseekFim.previousSuggestion",
        "key": "alt+[",
        "when": "editorTextFocus && inlineSuggestionVisible"
      }
    ],
    "configuration": {
      "title": "DeepSeek Autocomplete",
      "properties": {
        "deepseekFim.enabled": {
          "order": 1,
          "markdownDescription": "Master switch for inline completions.",
          "type": "boolean",
          "default": true
        },
        "deepseekFim.model": {
          "order": 2,
          "markdownDescription": "Model used for Fill-in-the-Middle completions. `deepseek-v4-flash` is fast and cheap; `deepseek-v4-pro` is higher quality.",
          "type": "string",
          "default": "deepseek-v4-flash",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro",
            "deepseek-chat",
            "deepseek-reasoner"
          ]
        },
        "deepseekFim.triggerMode": {
          "order": 3,
          "markdownDescription": "`automatic` requests completions while you type; `manual` only requests them on `Ctrl+Space`.",
          "type": "string",
          "default": "automatic",
          "enum": [
            "automatic",
            "manual"
          ],
          "enumDescriptions": [
            "Request completions automatically while typing (with debounce).",
            "Only request when explicitly triggered (Ctrl+Space)."
          ]
        },
        "deepseekFim.multilineCompletions": {
          "order": 4,
          "markdownDescription": "`auto` detects blocks (after `:`, `{`, `def`, `class`, ...); `always` / `never` force it on / off.",
          "type": "string",
          "default": "auto",
          "enum": [
            "always",
            "never",
            "auto"
          ],
          "enumDescriptions": [
            "Always allow multiline completions — full functions and blocks.",
            "Only single-line completions — stops at first statement end.",
            "Auto-detect based on cursor context (after :, {, def, class, if, etc.)."
          ]
        },
        "deepseekFim.debounceMs": {
          "order": 5,
          "description": "Debounce delay in ms before triggering a completion request while typing.",
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 5000
        },
        "deepseekFim.maxTokens": {
          "order": 6,
          "description": "Max tokens per completion. Auto-bumps to 1024 for multi-line.",
          "type": "number",
          "default": 256,
          "minimum": 16,
          "maximum": 4096
        },
        "deepseekFim.temperature": {
          "order": 7,
          "description": "Sampling temperature. 0 = deterministic, higher = more creative.",
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2
        },
        "deepseekFim.timeoutMs": {
          "order": 8,
          "markdownDescription": "HTTP timeout in milliseconds. Raise it if you see `ETIMEDOUT` on long multi-line completions.",
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 120000
        },
        "deepseekFim.contextEnrichment": {
          "order": 9,
          "markdownDescription": "Adds enclosing symbol, diagnostics, git diff, similar-code matching, and cross-file scans to the prompt. Off (default) keeps completions fast and predictable.",
          "type": "boolean",
          "default": false
        },
        "deepseekFim.streaming": {
          "order": 10,
          "markdownDescription": "Off (default) sends one non-streaming request. On consumes the SSE stream with early-break. VS Code renders inline completions only once complete, so single-request is usually simpler and more reliable.",
          "type": "boolean",
          "default": false
        },
        "deepseekFim.maxPrefixChars": {
          "order": 11,
          "description": "Maximum characters before cursor to include as prefix context.",
          "type": "number",
          "default": 6000,
          "minimum": 100,
          "maximum": 50000
        },
        "deepseekFim.maxSuffixChars": {
          "order": 12,
          "description": "Maximum characters after cursor to include as suffix context.",
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 50000
        },
        "deepseekFim.maxPrefixLines": {
          "order": 13,
          "description": "Maximum lines before cursor to include (applied after char limit).",
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 500
        },
        "deepseekFim.maxSuffixLines": {
          "order": 14,
          "description": "Maximum lines after cursor to include (applied after char limit).",
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 500
        },
        "deepseekFim.cacheSize": {
          "order": 15,
          "description": "LRU cache entries. 0 = disabled. Cache avoids repeat API calls for common prefixes.",
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 10000
        },
        "deepseekFim.streamingTimeout": {
          "order": 16,
          "description": "Single-line early-break timeout in ms. Multi-line uses HTTP timeout.",
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 10000
        },
        "deepseekFim.baseUrl": {
          "order": 17,
          "description": "DeepSeek API base URL. Change for custom/enterprise deployments.",
          "type": "string",
          "default": "https://api.deepseek.com/beta"
        },
        "deepseekFim.stopSequences": {
          "order": 18,
          "description": "Additional stop sequences for the model (appended to language defaults).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "deepseekFim.disableInFiles": {
          "order": 19,
          "description": "Glob patterns for files where completions are disabled.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "examples": [
            "**/*.min.js",
            "**/*.json",
            "**/secret*"
          ]
        },
        "deepseekFim.snippetSupport": {
          "order": 20,
          "description": "Enable SnippetString tab stops ($1, ${1:name}) in completions.",
          "type": "boolean",
          "default": false
        },
        "deepseekFim.alwaysShowCompletions": {
          "order": 21,
          "description": "Show completions immediately on every keystroke (bypasses debounce). May increase API usage.",
          "type": "boolean",
          "default": false
        },
        "deepseekFim.debug": {
          "order": 22,
          "markdownDescription": "Verbose logging to **Output: DeepSeek Autocomplete**. On by default so failures are visible.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "walkthroughs": [
      {
        "id": "deepseekFim.getStarted",
        "title": "Get started with DeepSeek Autocomplete",
        "description": "AI-powered inline code completions in a couple of minutes.",
        "steps": [
          {
            "id": "getApiKey",
            "title": "Get a DeepSeek API key",
            "description": "Create an API key on the DeepSeek platform. Free credits are available.\n[Get a key](https://platform.deepseek.com/api_keys)",
            "media": {
              "markdown": "walkthroughs/get-api-key.md"
            }
          },
          {
            "id": "setApiKey",
            "title": "Add your API key",
            "description": "Stored in your OS keychain - never in settings or logs.\n[Set API key](command:deepseekFim.setApiKey)",
            "media": {
              "markdown": "walkthroughs/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:deepseekFim.setApiKey"
            ]
          },
          {
            "id": "testConnection",
            "title": "Test the connection",
            "description": "Confirm the key works before you start coding. The result - and the exact reason if it fails - is shown in a notification.\n[Test connection](command:deepseekFim.testConnection)\n[Open log](command:deepseekFim.showLog)",
            "media": {
              "markdown": "walkthroughs/test-connection.md"
            },
            "completionEvents": [
              "onCommand:deepseekFim.testConnection"
            ]
          },
          {
            "id": "startCoding",
            "title": "Start coding",
            "description": "Open any file, pause, and accept the ghost text with Tab.\n[Open settings](command:workbench.action.openSettings?%22deepseekFim%22)",
            "media": {
              "markdown": "walkthroughs/start-coding.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && node esbuild.js",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.20.0",
    "eslint": "^8.50.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^5.3.0"
  }
}
